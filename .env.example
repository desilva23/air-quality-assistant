# Groq (AI plan and questions). Optional: without it the app uses its built-in plan.
GROQ_API_KEY=
# Optional model overrides.
GROQ_MODEL=
GROQ_LITE_MODEL=
# OpenAQ v3 (measured station readings). Optional: without it readings come from Open-Meteo (CAMS).
OPENAQ_API_KEY=
# Shared rate limits and cache across Vercel instances. Set automatically by Vercel's Upstash integration.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# How many proxies append to X-Forwarded-For in front of the app. 1 on Vercel.
TRUSTED_PROXY_HOPS=
