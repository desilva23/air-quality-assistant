# Copy to .env.local and fill in the two keys. Leave the commented lines alone:
# the app's defaults are right, and blank or placeholder values break things.

# Groq, for the AI plan and answers. Without it the app uses its built-in guidance.
GROQ_API_KEY=
# OpenAQ v3, for measured station readings. Without it readings come from the CAMS model.
OPENAQ_API_KEY=

# Optional model overrides (defaults shown).
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_LITE_MODEL=openai/gpt-oss-20b

# Shared rate limits and cache. Vercel's Upstash for Redis integration adds these;
# don't create them by hand.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Proxies in front of the app that append to X-Forwarded-For. The default, 1, is right for Vercel.
# TRUSTED_PROXY_HOPS=1
